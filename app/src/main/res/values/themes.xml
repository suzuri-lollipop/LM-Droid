<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LmDroid" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- AssistActivity: shows as an overlay on top of whatever app was already on screen (like
         Google Assistant), rather than switching away to our own full-screen task. -->
    <style name="Theme.LmDroid.Assist" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Character-mode variant of the assist theme: same look, but NOT translucent. A
         translucent window drops SurfaceView child surfaces entirely, which kills the MMD
         stage's GLSurfaceView; with a character the stage covers the full screen with its own
         (GL-drawn) background anyway. The window background stays transparent so the GL
         surface behind the window still shows through the unpainted pixels. -->
    <style name="Theme.LmDroid.Assist.Stage" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
