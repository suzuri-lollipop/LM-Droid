    <string name="websearch_max_rounds_placeholder">無制限</string>
    <string name="websearch_max_rounds_description">空欄または0の場合、AIが必要と判断する限り検索を繰り返せます。</string>
    <string name="websearch_profile_label">使用するプロファイル</string>
