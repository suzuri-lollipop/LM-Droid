    <string name="settings_websearch_category_title">Web検索</string>
    <string name="websearch_enable_label">Web検索を有効にする</string>
    <string name="websearch_enable_description">有効にすると、AIが必要だと判断した時に自らWeb検索やページ内容の取得を行い、その結果を参考にして返信できるようになります。</string>
