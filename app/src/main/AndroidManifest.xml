<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only needed pre-scoped-storage (API ≤ 28) to save an attachment into the public Pictures
         gallery — API 29+ can insert into MediaStore without this permission at all. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- For the composer's mic button (on-device speech-to-text via SpeechRecognizer). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- For the "get_current_location" tool (Settings → Web検索 → 位置情報を使用する). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- For the "set_alarm"/"set_timer" tools (Settings → アラーム・タイマー) to set them via the
         clock app without its own confirmation screen (EXTRA_SKIP_UI). Normal (install-time)
         permission — no runtime request needed. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Lets PackageManager list/resolve installed note-taking apps (Google Keep and others) for
         the "create_note" tool (Settings → メモ) without needing the broad QUERY_ALL_PACKAGES
         permission — see DeviceNoteController. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Lets PackageManager list/resolve installed music apps for the "play_music" tool
             (Settings → 音楽) — see DeviceMusicController. -->
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <!-- Lets DeviceAlarmController's resolveActivity() check (added when set_alarm/set_timer
             switched to the deferred-launch pattern shared with the other Intent-launching tools —
             see ConversationRepository's pendingSideEffects) actually see the clock app: without
             this, resolveActivity() — a query, unlike startActivity() — is subject to Android 11+
             package visibility and silently returned null for ACTION_SET_TIMER on at least one
             device (Samsung's Clock), reporting "no clock app available" even though one was
             installed and startActivity() would have worked fine. -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <application
        android:name=".LmDroidApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LmDroid"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LmDroid"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles the system assist gesture (see Settings → アシスタント to register this app
             as the device's assist app). exported=true is required for the system to be able to
             launch it via ACTION_ASSIST from outside this app's own process.

             taskAffinity="" + singleInstance keep this activity permanently isolated in its own
             task, never sharing one with MainActivity. Without this, taskAffinity defaults to the
             same value as MainActivity's, so the system routed the assist gesture into the app's
             existing task and brought MainActivity to the front first — visibly launching the
             whole app before the assistant overlay appeared on top of it, instead of overlaying
             directly on top of whatever app was already on screen. -->
        <activity
            android:name=".AssistActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.LmDroid.Assist">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Grants other apps temporary read access to a picked attachment's file (share sheet,
             image clipboard paste) without exposing the app's whole private storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
